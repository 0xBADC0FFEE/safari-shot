{
  "name": "safari-shot",
  "version": "0.1.0",
  "description": "Screenshots of web pages as iOS Safari shows them on iPhone, including what Safari paints under the status bar and the toolbar",
  "keywords": [
    "ios",
    "safari",
    "iphone",
    "screenshot",
    "liquid-glass",
    "theme-color",
    "playwright",
    "webkit",
    "cli"
  ],
  "homepage": "https://github.com/0xBADC0FFEE/safari-shot#readme",
  "bugs": "https://github.com/0xBADC0FFEE/safari-shot/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xBADC0FFEE/safari-shot.git"
  },
  "license": "MIT",
  "author": "0xBADC0FFEE",
  "type": "module",
  "bin": {
    "safari-shot": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "shot": "node src/cli.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
